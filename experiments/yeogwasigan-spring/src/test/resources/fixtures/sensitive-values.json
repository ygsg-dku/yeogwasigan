{
  "_설명": "게이트웨이 참고 경고(GatewayService.WARNING_PATTERNS) 시험 자료. 칸 하나짜리 기록의 값을 넣으면 expect 만큼 경고가 떠야 한다. expect 가 {} 이면 경고가 없어야 한다. note 가 있는 항목은 현재 기준의 한계를 기록한 것이다(준수 경고 기준 작업에서 판단).",
  "cases": [
    { "name": "에러 메시지 속 이메일", "field": "exception.message", "value": "payment failed for user kim@bank.com", "expect": { "EMAIL": 1 } },
    { "name": "대시로 끊은 카드번호", "field": "exception.message", "value": "card 4111-1111-1111-1111 declined", "expect": { "CARD": 1 } },
    { "name": "공백으로 끊은 카드번호", "field": "body", "value": "charge 4111 1111 1111 1111 failed", "expect": { "CARD": 1 } },
    { "name": "붙여 쓴 16자리 카드번호", "field": "body", "value": "cardNumber=4111111111111111", "expect": { "CARD": 1 } },
    { "name": "세션 UUID", "field": "body", "value": "session 3f2a9c1e-4b7d-4e2a-9c1e-8f3a2b1c0d9e expired", "expect": { "UUID": 1 } },
    { "name": "내부 IPv4", "field": "exception.message", "value": "connect to 10.0.3.21:50051 refused", "expect": { "IPV4": 1 } },
    { "name": "이메일과 IP 함께", "field": "body", "value": "user lee@corp.kr from 172.18.0.5", "expect": { "EMAIL": 1, "IPV4": 1 } },
    { "name": "같은 종류 두 번", "field": "body", "value": "a@x.com and b@y.org", "expect": { "EMAIL": 2 } },

    { "name": "19자리 timeUnixNano 는 카드가 아니다", "field": "timeUnixNano", "value": "1727654400123456789", "expect": {} },
    { "name": "traceId(32자리 16진수)", "field": "traceId", "value": "4bf92f3577b34da6a3ce929d0e0e4736", "expect": {} },
    { "name": "12자리 주문번호", "field": "body", "value": "order 202610071234 shipped", "expect": {} },
    { "name": "응답 시간과 상태 코드", "field": "body", "value": "GET /api/cart 500 took 1234ms", "expect": {} },
    { "name": "세 자리 버전 문자열", "field": "service.version", "value": "1.27.0", "expect": {} },

    { "name": "13자리 밀리초 타임스탬프", "field": "body", "value": "ts=1727654400123", "expect": { "CARD": 1 }, "note": "오탐. 13자리 숫자를 카드로 잡는다" },
    { "name": "네 자리 버전 문자열", "field": "service.version", "value": "2.4.1.0", "expect": { "IPV4": 1 }, "note": "오탐. 점 네 개짜리 버전을 IP로 잡는다" },
    { "name": "휴대폰 번호", "field": "body", "value": "contact 010-1234-5678", "expect": {}, "note": "미탐. 전화번호 경고 없음" },
    { "name": "계좌번호", "field": "body", "value": "account 110-123-456789", "expect": {}, "note": "미탐. 계좌번호 경고 없음" }
  ]
}
